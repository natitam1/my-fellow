# ==============================================================================
# My Fellow Monorepo — Master Environment Configuration Template
# Copy this file to .env or create per-app .env files in apps/*
# ==============================================================================

# Global
NODE_ENV=development

# ------------------------------------------------------------------------------
# Backend API (apps/api)
# ------------------------------------------------------------------------------
PORT=3000
DATABASE_URL="postgresql://fellow:fellow@localhost:5432/myfellow?schema=public"
MONGO_URI="mongodb://localhost:27017/myfellow"
JWT_SECRET="development_jwt_secret_must_be_at_least_32_characters_long"
JWT_EXPIRES_IN="30d"

# Third-party Integrations (Optional in Development)
GEEZ_API_KEY=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
JAMI_DEV_TOKEN=""
JAMI_LIVE_TOKEN=""
JAMI_WEBHOOK_SECRET=""

# Administrative Scripts
ADMIN_PHONE="0900000001"
OFFICIAL_PHONE="0900004000"

# ------------------------------------------------------------------------------
# Mobile Client (apps/mobile)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Admin Dashboard (apps/admin)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Public Website (apps/website)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Telegram Bot (apps/bot)
# ------------------------------------------------------------------------------
BOT_TOKEN=""
API_BASE_URL="http://localhost:3000"
