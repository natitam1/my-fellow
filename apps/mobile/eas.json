{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "bun": "1.4.4",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://my-fellow-api.onrender.com/api",
        "EXPO_PUBLIC_TELEGRAM_URL": "https://t.me/I4U_TEAM_bot",
        "EXPO_PUBLIC_TELEGRAM_LABEL": "4 Kilo Fellowship Telegram"
      }
    },
    "preview": {
      "bun": "1.4.4",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://my-fellow-api.onrender.com/api",
        "EXPO_PUBLIC_TELEGRAM_URL": "https://t.me/I4U_TEAM_bot",
        "EXPO_PUBLIC_TELEGRAM_LABEL": "4 Kilo Fellowship Telegram"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "bun": "1.4.4",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://my-fellow-api.onrender.com/api",
        "EXPO_PUBLIC_TELEGRAM_URL": "https://t.me/I4U_TEAM_bot",
        "EXPO_PUBLIC_TELEGRAM_LABEL": "4 Kilo Fellowship Telegram"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "alpha",
        "releaseStatus": "draft"
      }
    }
  }
}
