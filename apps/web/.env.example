# ==============================================================================
# 4 Kilo Fellowship Unified Web App & Admin Portal (apps/web)
# Copy this file to .env.local for local development
# ==============================================================================

# Public Backend API URL (used by browser client)
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Server-side Backend API URL (used by Next.js Route Handlers / SSR)
API_BASE_URL="http://localhost:3000"

# Optional Payment Gateway Keys (used by /api/payments/initialize)
JAMI_API_KEY=""
CHAPA_SECRET_KEY=""

# Optional Public Site Metadata Overrides
NEXT_PUBLIC_APP_VERSION="2.0.0"
NEXT_PUBLIC_PLAY_STORE_URL=""
NEXT_PUBLIC_TELEGRAM_BOT_URL="https://t.me/I4U_TEAM_bot"
NEXT_PUBLIC_GITHUB_REPO_URL="https://github.com/natitam1/my-fellow"
NEXT_PUBLIC_GITHUB_OWNER="natitam1"
NEXT_PUBLIC_GITHUB_REPO="my-fellow"
